{
  "name": "incar2",
  "version": "0.1.0",
  "private": true,
  "description": "Sitio institucional INCAR² — Centro Interdisciplinario para la Investigación Acuícola",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db": "node scripts/dev-db.mjs",
    "seed": "node --import ./scripts/payload-loader.mjs --env-file=.env.local scripts/seed.ts",
    "payload": "node --import ./scripts/payload-loader.mjs --env-file=.env.local node_modules/payload/bin.js --disable-transpile",
    "payload:types": "node --import ./scripts/payload-loader.mjs --env-file=.env.local node_modules/payload/bin.js generate:types --disable-transpile",
    "payload:importmap": "node --import ./scripts/payload-loader.mjs --env-file=.env.local node_modules/payload/bin.js generate:importmap --disable-transpile",
    "create-admin": "node --import ./scripts/payload-loader.mjs --env-file=.env.local scripts/create-admin.ts",
    "seed:members": "node --import ./scripts/payload-loader.mjs --env-file=.env.local scripts/seed-members.ts",
    "check-db": "node --import ./scripts/payload-loader.mjs --env-file=.env.local scripts/check-db.ts",
    "verify:members": "node --import ./scripts/payload-loader.mjs --env-file=.env.local scripts/verify-members.ts",
    "seed:pages": "node --import ./scripts/payload-loader.mjs --env-file=.env.local scripts/seed-pages.ts",
    "verify:pages": "node --import ./scripts/payload-loader.mjs --env-file=.env.local scripts/verify-pages.ts",
    "seed:lines": "node --import ./scripts/payload-loader.mjs --env-file=.env.local scripts/seed-lines.ts",
    "seed:documents": "node --import ./scripts/payload-loader.mjs --env-file=.env.local scripts/seed-documents.ts",
    "verify:documents": "node --import ./scripts/payload-loader.mjs --env-file=.env.local scripts/verify-documents.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/richtext-lexical": "^3.86.0",
    "@payloadcms/storage-vercel-blob": "^3.86.0",
    "@payloadcms/ui": "^3.86.0",
    "graphql": "^16.14.2",
    "next": "^16.2.10",
    "next-intl": "^4.3.4",
    "payload": "^3.86.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "^0.34.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.170.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9.30.0",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
