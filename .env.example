# ─────────────────────────────────────────────────────────────
# INCAR² — Variables de entorno (copiar a .env.local y completar)
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (sin barra final). Usada en SEO, sitemap y canonical.
NEXT_PUBLIC_SITE_URL=https://incar2.cl

# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX).
# Se toma de: Analytics → Administrar → Flujos de datos → flujo web.
# Si se deja vacío no se carga ninguna etiqueta. La medición además solo se
# activa en el despliegue de producción: en local y en las previsualizaciones
# de Vercel queda apagada a propósito para no ensuciar los datos.
# OJO: el sitio es estático, así que cambiar este valor exige volver a desplegar.
NEXT_PUBLIC_GA_ID=

# ── Fase 3 (Payload CMS) ──
# Base de datos PostgreSQL. Formato: postgres://user:pass@host:puerto/db
#
# Desarrollo local: usar el Postgres embebido (`npm run db`). Estas credenciales
# son fijas y NO deben usarse en producción:
DATABASE_URI=postgres://incar:incar@localhost:5432/incar
#
# Producción (Neon): reemplazar por la cadena de conexión del proyecto Neon,
# p.ej. postgres://USER:PASS@ep-xxxx.sa-east-1.aws.neon.tech/incar?sslmode=require

# Secreto para firmar sesiones/tokens del panel admin. Cadena aleatoria larga.
# Generar con: openssl rand -base64 32
PAYLOAD_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# Almacenamiento de las imágenes subidas desde el panel (Vercel Blob).
# Obligatorio en producción: el disco de Vercel es efímero y sin esto cada
# imagen cargada se pierde en el siguiente despliegue. En local se deja vacío
# y las subidas van a `public/media`.
# Se crea con: vercel blob create-store  → Vercel inyecta esta variable sola.
BLOB_READ_WRITE_TOKEN=

# Fuerza el contenido estático desde `src/content/*.ts` ignorando la base de
# datos. Solo para previsualizar sin Postgres; en producción se deja SIN definir
# para que el panel sea la fuente de verdad.
# CMS_SOURCE=static
